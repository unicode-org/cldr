<?xml version="1.0" encoding="UTF-8"?>
<keyboard3 xmlns="https://schemas.unicode.org/cldr/45/keyboard3" locale="shn" conformsTo="45">
  <info name="Shan SIIT" layout="QWERTY" indicator="တႆး" author="Shan IIT"/>

  <!-- Unshifted Layer -->
  <layer modifiers="none">
    <row keys="` 1 2 3 4 5 6 7 8 9 0 - ="/>
    <row keys="ၸ တ ၼ မ ဢ ပ ၵ င ဝ ႁ [ ]"/>
    <row keys="ေ ႄ ိ ် ွ ႉ ႇ ု ူ ႈ '"/>
    <row keys="ၽ ထ ၶ လ ယ ၺ ၢ , . /"/>
  </layer>

  <!-- Shifted Layer -->
  <layer modifiers="shift">
    <row keys="~ ! @ # $ % ^ &amp; * ( ) _ +"/>
    <row keys="ꩡ ၻ ꧣ ႞ ြ ၿ ၷ ရ သ ႀ { }"/>
    <row keys="ဵ ႅ ီ ႂ် ႂ ံ ႆ ” ႊ း &quot;"/>
    <row keys="ၾ ꩪ ꧠ ꩮ ျ ႟ ႃ ၊ ။ ?"/>
  </layer>

  <!-- AltGr (Right-Alt) Layer -->
  <layer modifiers="altR">
    <row keys="` 1 ၁ 2 ၂ 3 ၃ 4 ၄ 5 ၅ 6 ၆ 7 ၇ 8 ၈ 9 ၉ 0 ၀ - ="/>
    <row keys="ၹ ꩦ e r t y u i o ꧡ p [ ] \"/>
    <row keys="a s ဝꧥ d f g h j k l ; '"/>
    <row keys="ꧤ ꩧ c v b n m , . /"/>
  </layer>

  <!-- AltGr + Shift Layer -->
  <layer modifiers="altR shift">
    <row keys="` 1 ႑ 2 ႒ 3 ႓ 4 ့ 5 ႕ 6 ႖ 7 ႗ 8 ႘ 9 ႙ 0 ႐ - ="/>
    <row keys="q w ꩨ e r t y u i o ꧢ p [ ] \"/>
    <row keys="a s d f g h ့ j k l ; '"/>
    <row keys="z x ꩩ c v b n m , . /"/>
  </layer>

